NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://bromeoremote.com

# Coolify PostgreSQL 17 service URL.
DATABASE_URL=postgresql://bromeoremote:change-me@postgres:5432/bromeoremote

# Mail settings. Keep SMTP_PASS only in Coolify environment variables.
SMTP_HOST=mail.thegatekeeperenterprises.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@bromeoremote.com
SMTP_PASS=
SMTP_FROM=info@bromeoremote.com
SMTP_TO=info@bromeoremote.com

# Public download locations. These can point to Coolify storage, an updates subdomain,
# GitHub Releases, or another HTTPS file host.
DOWNLOAD_WINDOWS_URL=https://updates.bromeoremote.com/BromeoRemote-Installer.exe
DOWNLOAD_WINDOWS_PORTABLE_URL=https://updates.bromeoremote.com/BromeoRemote-Setup.exe
DOWNLOAD_ANDROID_URL=https://downloads.bromeoremote.com/BromeoRemote-Android.apk
DOWNLOAD_GITHUB_URL=

# Optional links shown on the website.
SIGNALING_STATUS_URL=https://remote.bromeoremote.com/health
DOCS_URL=https://github.com/your-org/bromeoremote/tree/main/docs
